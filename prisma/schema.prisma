generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  staff
  admin
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role   @default(customer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users") // ให้ชื่อตารางใน Database เป็น "users"
}
